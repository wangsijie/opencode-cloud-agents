{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKUP_BUCKET_NAME": "opencode-cloud-backups",
    "PERSISTENCE_LOCAL_BUCKET": "false"
  },
  // The Hub SPA. `run_worker_first` keeps every route decision in the Worker:
  // the origin check runs on every request, `/` serves either the SPA or the
  // stock UI depending on its query, and `/assets/` still belongs to the
  // container proxy. Letting the asset server answer first would quietly break
  // all three.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "opencode-cloud-backups"
    }
  ],
  // The session registry and settings. Always read through the primary — the
  // D1 Sessions API (read replication) is deliberately unused, so every query
  // is strongly consistent.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-cloud",
      "database_id": "e2b7a5ee-3a63-4aec-a8c8-81393dcf2727",
      "migrations_dir": "migrations"
    }
  ],
  // A rollout replaces every running container, and a container that dies
  // without checkpointing takes its conversation with it — checkpoints happen
  // only at idle-stop. The grace period is the minimum time an active instance
  // is left alone before it becomes eligible for updating, so a session in the
  // middle of a prompt survives a deploy instead of being lost. The cost is
  // that new Worker code drives old-image containers for that whole window.
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-4",
      "rollout_active_grace_period": 900
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "Hub",
        "name": "Hub"
      },
      {
        "class_name": "LifecycleCoordinator",
        "name": "LifecycleCoordinator"
      },
      {
        "class_name": "SessionAgent",
        "name": "SessionAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["Hub"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["LogtoSandbox"],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": ["LifecycleCoordinator"],
      "tag": "v4"
    },
    {
      "new_sqlite_classes": ["SessionAgent"],
      "tag": "v5"
    },
    {
      "deleted_classes": ["LogtoSandbox"],
      "tag": "v6"
    }
  ]
}
