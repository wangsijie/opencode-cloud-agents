{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKUP_BUCKET_NAME": "opencode-cloud-backups",
    "PERSISTENCE_LOCAL_BUCKET": "false"
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "opencode-cloud-backups"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "image_vars": {
        "WORKSPACE_TEMPLATE": "base"
      },
      "instance_type": "standard-4"
    },
    {
      "class_name": "LogtoSandbox",
      "image": "./Dockerfile",
      "image_vars": {
        "WORKSPACE_TEMPLATE": "logto"
      },
      "instance_type": "standard-4"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "LogtoSandbox",
        "name": "LogtoSandbox"
      },
      {
        "class_name": "Hub",
        "name": "Hub"
      },
      {
        "class_name": "LifecycleCoordinator",
        "name": "LifecycleCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["Hub"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["LogtoSandbox"],
      "tag": "v3"
    },
    {
      "new_sqlite_classes": ["LifecycleCoordinator"],
      "tag": "v4"
    }
  ]
}
